# HOPE mobile SEO routes only
RewriteEngine On
RewriteRule ^experience\.html$ /hope-mobile/体験トレーニング/ [R=301,L]
RewriteRule ^kaatsu\.html$ /hope-mobile/加圧トレーニングの効果/ [R=301,L]
RewriteRule ^pricing\.html$ /hope-mobile/パーソナルトレーニング料金/ [R=301,L]
RewriteRule ^membership\.html$ /hope-mobile/入会案内/ [R=301,L]
RewriteRule ^faq\.html$ /hope-mobile/よくある質問/ [R=301,L]
RewriteRule ^profile\.html$ /hope-mobile/トレーナー紹介/ [R=301,L]
